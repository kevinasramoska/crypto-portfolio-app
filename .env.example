# Full-stack local environment example.
# Copy to .env.local and source it before running the backend if you want shell env overrides.
# Spring Boot also has matching local defaults in application.yaml.

DB_URL=jdbc:postgresql://localhost:5432/cryptodb
DB_USERNAME=postgres
DB_PASSWORD=postgres

SERVER_PORT=8080
JWT_SECRET=local-development-jwt-secret-32-bytes-minimum
JWT_EXPIRATION_SECONDS=3600

CRYPTO_API_BASE_URL=https://api.coingecko.com/api/v3
SPRING_JPA_SHOW_SQL=true

PORTFOLIO_SNAPSHOT_FIXED_DELAY_MS=3600000
PORTFOLIO_SNAPSHOT_INITIAL_DELAY_MS=300000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
